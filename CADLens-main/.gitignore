# Dependency directories
node_modules/
**/node_modules/

# Build outputs
dist/
dist-ssr/
build/

# Uploaded files and user storage
storage/uploads/*
!storage/uploads/.gitkeep

# Exported Excel files (generated at runtime)
storage/exports/*
!storage/exports/.gitkeep

# Python environment and cache
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/
venv/
.venv/
env/
ENV/
pyvenv.cfg
*.egg-info/
.eggs/

# Environment variables / local configuration
.env
.env.local
.env.*.local

# Editor and IDE configurations
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# YOLO model weights (large binary — download separately)
*.pt
*.onnx

# OS metadata
.DS_Store
Thumbs.db
